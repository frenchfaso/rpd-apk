+/* Kept separately so the exact bounds/copy logic can be tested under ASan. */
+static int m10_append_therm_channel(struct adc5_chip *adc, unsigned int index)
+{
+	struct adc5_channel_prop *source = NULL, *dest;
+	struct iio_chan_spec *chan;
+	unsigned int i;
+
+	if (!adc->chan_props || !adc->iio_chans || !index ||
+	    adc->nchannels > ADC5_MAX_CHANNEL || index >= adc->nchannels ||
+	    index != adc->nchannels - 1)
+		return -EINVAL;
+	for (i = 0; i < index; i++) {
+		if (adc->chan_props[i].channel == ADC5_BAT_THERM_30K_PU)
+			return -EEXIST;
+		if (adc->chan_props[i].channel == ADC5_BAT_ID_100K_PU) {
+			if (source)
+				return -EEXIST;
+			source = &adc->chan_props[i];
+		}
+	}
+	if (!source || source->cal_method != ADC5_RATIOMETRIC_CAL ||
+	    source->prescale != 0)
+		return -EINVAL;
+
+	/* Reuse board timing, upstream conversion mutex and IRQ handling. */
+	dest = &adc->chan_props[index];
+	chan = &adc->iio_chans[index];
+	*dest = *source;
+	dest->channel = ADC5_BAT_THERM_30K_PU;
+	dest->scale_fn_type = SCALE_HW_CALIB_DEFAULT;
+	dest->channel_name = "bat_therm_uv";
+	chan->channel = ADC5_BAT_THERM_30K_PU;
+	chan->datasheet_name = "bat_therm_uv";
+	chan->extend_name = "bat_therm_uv";
+	chan->info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED);
+	chan->type = IIO_VOLTAGE;
+	chan->address = index;
+	return 0;
+}
