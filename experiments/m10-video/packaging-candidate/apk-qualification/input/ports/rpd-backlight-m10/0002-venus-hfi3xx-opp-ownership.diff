+static int venus_runtime_suspend_opp_v3(struct venus_core *core)
+{
+	int ret;
+
+	if (core->opp_power.recovery_failed) {
+		venus_opp_release_v3(core);
+		return 0;
+	}
+	ret = hfi_core_suspend(core);
+	if (ret)
+		return ret;
+
+	venus_opp_release_v3(core);
+
+	/* Do not report active after HFI and the clocks have stopped. */
+	return 0;
+}
+
+static int venus_runtime_resume_opp_v3(struct venus_core *core)
+{
+	int ret, err;
+
+	if (core->opp_power.recovery_failed)
+		return -EIO;
+	ret = icc_set_bw(core->video_path, kbps_to_icc(20000), 0);
+	if (ret)
+		return ret;
+	ret = icc_set_bw(core->cpucfg_path, kbps_to_icc(1000), 0);
+	if (ret)
+		goto err_video;
+	ret = core->pm_ops->core_power(core, POWER_ON);
+	if (ret)
+		goto err_cpucfg;
+	ret = hfi_core_resume(core, false);
+	if (!ret)
+		return 0;
+
+	core->pm_ops->core_power(core, POWER_OFF);
+err_cpucfg:
+	err = icc_set_bw(core->cpucfg_path, 0, 0);
+	if (err)
+		dev_warn(core->dev, "CPU bandwidth cleanup failed: %d\n", err);
+err_video:
+	err = icc_set_bw(core->video_path, 0, 0);
+	if (err)
+		dev_warn(core->dev, "Video bandwidth cleanup failed: %d\n", err);
+	return ret;
 }
 
