+
+static void venus_opp_shutdown_v3(struct venus_core *core)
+{
+	int ret;
+
+	/* PAS shutdown is an SCM call; the non-TZ path accesses registers. */
+	if (!core->use_tz && !core->opp_power.active)
+		return;
+	ret = venus_shutdown(core);
+	if (ret)
+		dev_warn(core->dev, "Firmware shutdown failed: %d\n", ret);
+}
+
+static void venus_opp_release_v3(struct venus_core *core)
+{
+	int ret;
+
+	core->pm_ops->core_power(core, POWER_OFF);
+	ret = icc_set_bw(core->cpucfg_path, 0, 0);
+	if (ret)
+		dev_warn(core->dev, "CPU bandwidth cleanup failed: %d\n", ret);
+	ret = icc_set_bw(core->video_path, 0, 0);
+	if (ret)
+		dev_warn(core->dev, "Video bandwidth cleanup failed: %d\n", ret);
+}
+
+static void venus_opp_stop_recovery_v3(struct venus_core *core)
+{
+	int ret;
+
+	if (!core->opp_power.recovery_failed) {
+		core->opp_power.recovery_failed = true;
+		pm_runtime_disable(core->dev);
+	}
+	core->ops->core_deinit(core);
+	core->state = CORE_UNINIT;
+	venus_opp_shutdown_v3(core);
+	venus_opp_release_v3(core);
+	ret = pm_runtime_set_suspended(core->dev);
+	if (ret)
+		dev_warn(core->dev, "Failed to mark stopped core suspended: %d\n", ret);
+	dev_err(core->dev, "Runtime PM recovery failed; reprobe required\n");
+}
