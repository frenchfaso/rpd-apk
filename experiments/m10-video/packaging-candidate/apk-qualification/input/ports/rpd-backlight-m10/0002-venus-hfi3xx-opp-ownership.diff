+static int core_opp_power_off_v3(struct venus_core *core)
+{
+	struct venus_opp_power *power = &core->opp_power;
+	struct device *cx = core->opp_pmdomain->pd_devs[0];
+	struct device *pd;
+	int ret, err = 0, opp_ret, cx_ret;
+	unsigned int i;
+
+	for (i = 0; i < power->domains; i++) {
+		pd = core->pmdomains->pd_devs[i];
+		ret = dev_pm_genpd_set_hwmode(pd, false);
+		if (ret && ret != -EOPNOTSUPP && !err)
+			err = ret;
+	}
+	if (power->vcodec_clks) {
+		vcodec_clks_disable(core, core->vcodec_clks);
+		power->vcodec_clks = false;
+	}
+	if (power->core_clks) {
+		core_clks_disable(core);
+		power->core_clks = false;
+	}
+	power->active = false;
+
+	while (power->domains) {
+		pd = core->pmdomains->pd_devs[--power->domains];
+		/* put_sync consumes our reference even when suspend fails. */
+		ret = pm_runtime_put_sync(pd);
+		if (ret < 0 && !err)
+			err = ret;
+	}
+
+	if (power->vote) {
+		/* A retry must clear the actual vote, not just cached resume state. */
+		if (!power->cx) {
+			ret = pm_runtime_resume_and_get(cx);
+			if (ret) {
+				if (!err)
+					err = ret;
+				goto out;
+			}
+			power->cx = true;
+		}
+		opp_ret = dev_pm_opp_set_rate(core->dev, 0);
+		/* The OPP core may already have marked a failed vote disabled. */
+		cx_ret = dev_pm_domain_set_performance_state(cx, 0);
+		if (!opp_ret && !cx_ret) {
+			power->vote = false;
+			power->rate_failed = false;
+		}
+		if (!err)
+			err = opp_ret ? opp_ret : cx_ret;
+	}
+
+	if (power->cx) {
+		ret = pm_runtime_put_sync(cx);
+		power->cx = false;
+		if (ret < 0 && !err)
+			err = ret;
+	}
+out:
+	if (err)
+		dev_warn(core->dev, "OPP power cleanup failed: %d\n", err);
+	return err;
+}
+
+static int core_opp_power_v3(struct venus_core *core, int on)
+{
+	struct venus_opp_power *power = &core->opp_power;
+	struct device *cx = core->opp_pmdomain->pd_devs[0];
+	struct device *pd;
+	int ret;
+
+	if (on == POWER_OFF) {
+		core_opp_power_off_v3(core);
+		/* Clocks are off, even if a provider retained a power/BW vote. */
+		return 0;
+	}
+	if (power->recovery_failed)
+		return -EIO;
+	if (power->active)
+		return 0;
+
+	/* Retry failed OPP bookkeeping before permitting clocks to restart. */
+	if (power->vote) {
+		ret = core_opp_power_off_v3(core);
+		if (ret)
+			return ret;
+	}
+	ret = pm_runtime_resume_and_get(cx);
+	if (ret)
+		return ret;
+	power->cx = true;
+
+	ret = core_opp_set_rate_v3(core, power->freq);
+	if (ret)
+		goto err;
+
+	while (power->domains < core->res->vcodec_pmdomains_num) {
+		pd = core->pmdomains->pd_devs[power->domains];
+		ret = pm_runtime_resume_and_get(pd);
+		if (ret)
+			goto err;
+		power->domains++;
+	}
+	ret = core_clks_enable(core);
+	if (ret)
+		goto err;
+	power->core_clks = true;
+
+	ret = vcodec_clks_enable(core, core->vcodec_clks);
+	if (ret)
+		goto err;
+	power->vcodec_clks = true;
+
+	ret = vcodec_domains_set_hw(core, true);
+	if (ret)
+		goto err;
+	power->active = true;
+	return 0;
+err:
+	core_opp_power_off_v3(core);
+	return ret;
+}
