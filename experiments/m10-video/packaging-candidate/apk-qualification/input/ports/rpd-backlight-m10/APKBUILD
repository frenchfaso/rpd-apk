arch="aarch64"
license="GPL-2.0-only"
subpackages="rpd-gpu-m10:gpu rpd-usb-otg-m10:otg rpd-battery-m10:battery rpd-charger-m10:charger rpd-audio-m10:audio rpd-video-m10:video"
install="rpd-video-m10.post-install rpd-video-m10.post-upgrade rpd-video-m10.pre-deinstall rpd-video-m10.post-deinstall rpd-gpu-m10.post-install rpd-gpu-m10.post-upgrade rpd-gpu-m10.pre-deinstall rpd-audio-m10.post-install rpd-audio-m10.post-upgrade rpd-audio-m10.post-deinstall rpd-charger-m10.post-install rpd-charger-m10.post-upgrade rpd-charger-m10.pre-deinstall rpd-backlight-m10.post-install rpd-backlight-m10.post-upgrade rpd-usb-otg-m10.post-install rpd-usb-otg-m10.post-upgrade rpd-usb-otg-m10.pre-deinstall rpd-battery-m10.post-install rpd-battery-m10.post-upgrade rpd-battery-m10.pre-deinstall"
