    pkgdesc="Guarded Lenovo M10 OEM charge-termination threshold"
    depends="python3 kmod rpd-battery-m10=$pkgver-r$pkgrel"
    install -Dm644 "$srcdir/backlight-module/m10_charger.ko" \
        "$subpkgdir/usr/lib/modules/$pkgver-msm89x7/extra/m10_charger.ko"
    install -Dm755 "$srcdir/rpd-charger-m10-load" "$subpkgdir/usr/libexec/rpd-charger-m10-load"
    install -Dm644 "$srcdir/rpd-charger-m10.service" "$subpkgdir/usr/lib/systemd/system/rpd-charger-m10.service"
    install -Dm644 "$srcdir/80-rpd-charger-m10.preset" "$subpkgdir/usr/lib/systemd/system-preset/80-rpd-charger-m10.preset"
    mkdir -p "$subpkgdir/usr/lib/rpd-charger-m10"
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" \
        > "$subpkgdir/usr/lib/rpd-charger-m10/kernel.json"
}

audio() {
    pkgdesc="Lenovo M10 PM8953 internal stereo speakers"
    depends="kmod python3 py3-libfdt alsa-ucm-conf rpd-cpu-topology-m10"
    for module in m10_audio_pmic m10_wcd_analog m10_speaker_amp; do
        install -Dm644 "$srcdir/backlight-module/$module.ko" \
            "$subpkgdir/usr/lib/modules/$pkgver-msm89x7/extra/$module.ko"
    done
    for file in audio-dtb.py base.dtb audio.dtb; do
        install -Dm644 "$srcdir/$file" "$subpkgdir/usr/lib/rpd-audio-m10/$file"
    done
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" \
        > "$subpkgdir/usr/lib/rpd-audio-m10/kernel.json"
    install -Dm755 "$srcdir/95-rpd-audio-m10" "$subpkgdir/usr/share/boot-deploy/hooks/95-rpd-audio-m10"
    install -Dm644 "$srcdir/Lenovo-M10.conf" "$subpkgdir/usr/share/alsa/ucm2/conf.d/Lenovo-M10/Lenovo-M10.conf"
    install -Dm644 "$srcdir/HiFi.conf" "$subpkgdir/usr/share/alsa/ucm2/Lenovo/M10/HiFi.conf"
    install -Dm644 "$srcdir/51-rpd-m10-audio.conf" "$subpkgdir/etc/wireplumber/wireplumber.conf.d/51-rpd-m10-audio.conf"
    mkdir -p "$subpkgdir/usr/share/mkinitfs-triggers"
    touch "$subpkgdir/usr/share/mkinitfs-triggers/rpd-audio-m10"
}


gpu() {
    pkgdesc="Verified Adreno 504 support for Lenovo M10, with kernel upgrade fallback"
    depends="mesa-egl mesa-gles mesa-gbm mesa-dri-gallium kmod python3 py3-libfdt rpd-audio-m10=$pkgver-r$pkgrel"
    install -Dm644 "$srcdir/gpu-module/drivers/gpu/drm/msm/msm.ko" "$subpkgdir/usr/lib/rpd-gpu-m10/msm.ko"
    install -Dm644 "$srcdir/gpu-module/drivers/soc/qcom/ubwc_config.ko" "$subpkgdir/usr/lib/rpd-gpu-m10/ubwc_config.ko"
    install -Dm755 "$srcdir/gpu-probe" "$subpkgdir/usr/libexec/rpd-gpu-m10-probe"
    install -Dm644 "$srcdir/gpu-renderer.sh" "$subpkgdir/usr/lib/rpd-gpu-m10/renderer.sh"
    for file in gpu-dtb.py base.dtb; do
        install -Dm644 "$srcdir/$file" "$subpkgdir/usr/lib/rpd-gpu-m10/$file"
    done
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" > "$subpkgdir/usr/lib/rpd-gpu-m10/kernel.json"
    install -Dm755 "$srcdir/96-rpd-gpu-m10" "$subpkgdir/usr/share/boot-deploy/hooks/96-rpd-gpu-m10"
    install -Dm755 "$srcdir/rpd-gpu-m10-load" "$subpkgdir/usr/libexec/rpd-gpu-m10-load"
    install -Dm644 "$srcdir/rpd-gpu-m10.service" "$subpkgdir/usr/lib/systemd/system/rpd-gpu-m10.service"
    install -Dm644 "$srcdir/rpd-gpu-m10.files" "$subpkgdir/usr/share/mkinitfs/files/rpd-gpu-m10.files"
    install -Dm644 "$srcdir/rpd-gpu-m10.conf" "$subpkgdir/etc/modprobe.d/rpd-gpu-m10.conf"
    install -Dm644 "$srcdir/80-rpd-gpu-m10.preset" "$subpkgdir/usr/lib/systemd/system-preset/80-rpd-gpu-m10.preset"
    mkdir -p "$subpkgdir/usr/share/mkinitfs-triggers"
    touch "$subpkgdir/usr/share/mkinitfs-triggers/rpd-gpu-m10"
}


video() {
    pkgdesc="Experimental optional Lenovo M10 Venus decoder (unqualified candidate)"
    depends="python3 py3-libfdt kmod rpd-gpu-m10=$pkgver-r$pkgrel"
    # No standard /usr/lib/modules files, aliases or installed media binaries
    # are replaced. An unqualified upgrade ships only a disabled metadata payload.
    for file in kernel.json base.dtb; do
        if [ -f "$srcdir/video-module/$file" ]; then
            install -Dm644 "$srcdir/video-module/$file" "$subpkgdir/usr/lib/rpd-video-m10/$file"
        fi
    done
    for file in "$srcdir/video-module/"*.ko; do
        [ -f "$file" ] || continue
        install -Dm644 "$file" "$subpkgdir/usr/lib/rpd-video-m10/${file##*/}"
    done
    for file in video-dtb.py venus-candidate.py reserve-only.py verify-allocation.py video-qualification.json; do
        install -Dm644 "$srcdir/$file" "$subpkgdir/usr/lib/rpd-video-m10/$file"
    done
    install -Dm755 "$srcdir/rpd-video-m10-load" "$subpkgdir/usr/libexec/rpd-video-m10-load"
    install -Dm755 "$srcdir/97-rpd-video-m10" "$subpkgdir/usr/share/boot-deploy/hooks/97-rpd-video-m10"
    install -Dm644 "$srcdir/rpd-video-m10.service" "$subpkgdir/usr/lib/systemd/system/rpd-video-m10.service"
    install -Dm644 "$srcdir/80-rpd-video-m10.preset" "$subpkgdir/usr/lib/systemd/system-preset/80-rpd-video-m10.preset"
    mkdir -p "$subpkgdir/usr/share/mkinitfs-triggers"
    touch "$subpkgdir/usr/share/mkinitfs-triggers/rpd-video-m10"
}

