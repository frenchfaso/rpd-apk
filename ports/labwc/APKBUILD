# Contributor: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
pkgname=labwc
pkgver=0.20.2
pkgrel=118
pkgdesc="Wayland stacking compositor"
url="https://github.com/labwc/labwc"
arch="aarch64"
license="GPL-2.0-only"
depends="xwayland"
makedepends="
	cairo-dev
	glib-dev
	libinput-dev
	libsfdo-dev
	librsvg-dev
	libxml2-dev
	meson
	pango-dev
	scdoc
	wayland-protocols
	wlroots0.20-dev
	xwayland-dev
	"
subpackages="$pkgname-doc $pkgname-lang"
source="https://github.com/labwc/labwc/archive/$pkgver/labwc-$pkgver.tar.gz
	two-finger-tap.patch rpd-two-finger.h test-two-finger.c
	"

prepare() {
    default_prepare
    cp "$srcdir/rpd-two-finger.h" include/input/
}

build() {
	abuild-meson . output -Dman-pages=enabled
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
    cc -std=c11 -Wall -Wextra -Werror -I"$srcdir" "$srcdir/test-two-finger.c" -o output/test-two-finger
    output/test-two-finger
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

