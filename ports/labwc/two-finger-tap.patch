@@ -223,11 +446,27 @@
 	CONNECT_SIGNAL(seat->cursor, seat, touch_up);
 	CONNECT_SIGNAL(seat->cursor, seat, touch_motion);
 	CONNECT_SIGNAL(seat->cursor, seat, touch_frame);
+    const char *enabled = getenv("RPD_TWO_FINGER_RIGHT_CLICK");
+    if (enabled && strcmp(enabled, "1") == 0) {
+        seat->touch_gesture = znew(*seat->touch_gesture);
+        wl_list_init(&seat->touch_gesture->devices);
+        seat->touch_down.notify = rpd_touch_down;
+        seat->touch_motion.notify = rpd_touch_motion;
+        seat->touch_up.notify = rpd_touch_up;
+    }
 }
 
 void
 touch_finish(struct seat *seat)
 {
+    if (seat->touch_gesture) {
+        struct rpd_touch_context *ctx, *tmp;
+        wl_list_for_each_safe(ctx, tmp, &seat->touch_gesture->devices, link) {
+            rpd_device_destroy(&ctx->destroy, NULL);
+        }
+        free(seat->touch_gesture);
+        seat->touch_gesture = NULL;
+    }
 	wl_list_remove(&seat->touch_down.link);
 	wl_list_remove(&seat->touch_up.link);
 	wl_list_remove(&seat->touch_motion.link);
