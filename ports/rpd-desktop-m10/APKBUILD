pkgname=rpd-desktop-m10
pkgver=0.1.0
pkgrel=72
pkgdesc="Minimal portable Raspberry Pi desktop (rpd-desktop-m10)"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="rpd-gpu-m10 rpd-audio-m10 rpd-lvm-m10 rpd-charger-m10 rpd-power rpd-cpu-topology-m10 rpd-usb-otg-m10 rpd-backlight-m10 rpd-autorotate rpd-desktop-browser labwc=0.20.2-r150"
options="!check"
source="99-rpd-m10-storage.rules screen-power.conf autorotate.conf 61-rpd-m10.conf greeter-renderer.conf rpd-session-m10 rpd-session-m10.desktop"

package() {
    install -Dm644 "$srcdir/99-rpd-m10-storage.rules" "$pkgdir/usr/lib/udev/rules.d/99-rpd-m10-storage.rules"
    install -Dm644 "$srcdir/screen-power.conf" "$pkgdir/etc/xdg/rpd/screen-power.conf"
    install -Dm644 "$srcdir/autorotate.conf" "$pkgdir/etc/xdg/rpd/autorotate.conf"
    install -Dm644 "$srcdir/61-rpd-m10.conf" "$pkgdir/etc/lightdm/lightdm.conf.d/61-rpd-m10.conf"
    install -Dm644 "$srcdir/greeter-renderer.conf" "$pkgdir/etc/xdg/rpd/greeter-renderer.conf"
    install -Dm755 "$srcdir/rpd-session-m10" "$pkgdir/usr/bin/rpd-session-m10"
    install -Dm644 "$srcdir/rpd-session-m10.desktop" "$pkgdir/usr/share/wayland-sessions/rpd-session-m10.desktop"
}

