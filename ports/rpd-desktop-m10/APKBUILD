package() {
    install -Dm755 "$srcdir/rpd-session-m10" "$pkgdir/usr/bin/rpd-session-m10"
    install -Dm644 "$srcdir/rpd-session-m10.desktop" "$pkgdir/usr/share/wayland-sessions/rpd-session-m10.desktop"
}

