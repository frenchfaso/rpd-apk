pkgname=rpd-desktop-m10
pkgver=0.1.0
pkgrel=4
pkgdesc="Minimal portable Raspberry Pi desktop (rpd-desktop-m10)"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="rpd-desktop-lite"
options="!check"
source="61-rpd-m10.conf greeter-renderer.conf rpd-session-m10 rpd-session-m10.desktop"

package() {
    install -Dm644 "$srcdir/61-rpd-m10.conf" "$pkgdir/etc/lightdm/lightdm.conf.d/61-rpd-m10.conf"
    install -Dm644 "$srcdir/greeter-renderer.conf" "$pkgdir/etc/xdg/rpd/greeter-renderer.conf"
    install -Dm755 "$srcdir/rpd-session-m10" "$pkgdir/usr/bin/rpd-session-m10"
    install -Dm644 "$srcdir/rpd-session-m10.desktop" "$pkgdir/usr/share/wayland-sessions/rpd-session-m10.desktop"
}

