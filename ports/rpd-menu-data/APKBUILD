pkgname=rpd-menu-data
pkgver=1.34
pkgrel=5
pkgdesc="Portable Raspberry Pi Desktop: rpd-metas"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="BSD-3-Clause"
depends=""
makedepends="desktop-file-utils"
options="!check"
# Upstream has no applicable test suite; repository smoke tests run separately.
source="https://archive.raspberrypi.com/debian/pool/main/r/rpd-metas/rpd-metas_1.34.tar.xz"
builddir="$srcdir/rpd-metas"

package() {
    mkdir -p "$pkgdir/etc/xdg/rpd/menus" "$pkgdir/usr/share"
    cp common/etc/xdg/menus/rpd-applications.menu "$pkgdir/etc/xdg/rpd/menus/"
    cp -a common/usr/share/desktop-directories common/usr/share/raspi-ui-overrides common/usr/share/raspberrypi-artwork common/usr/share/rpd-wallpaper "$pkgdir/usr/share/"
    mkdir -p "$pkgdir/etc/xdg/rpd"
    cp -a common/etc/xdg/qt5ct common/etc/xdg/qt6ct "$pkgdir/etc/xdg/rpd/"
    sed -i "/x-www-browser.desktop/d; /Thonny.desktop/d; /glade.desktop/d" "$pkgdir/usr/share/raspi-ui-overrides/applications/mimeapps.list"
    update-desktop-database "$pkgdir/usr/share/raspi-ui-overrides/applications"
    install -Dm644 debian/copyright "$pkgdir/usr/share/licenses/$pkgname/copyright"
}

