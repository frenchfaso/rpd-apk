pkgname=rpd-settings-backend
pkgver=0.1.0
pkgrel=37
pkgdesc="Portable settings integration for Raspberry Pi Desktop"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="python3 polkit openssh"
source="rpd-configure-host rpd-list-touchscreens rpd-user-settings rpd-system-settings org.rpd.system-settings.policy test-system-settings.py rpd-apply-greeter rpd-greeter-settings org.rpd.greeter-settings.policy test-settings.py"
check() {
    python3 "$srcdir/test-system-settings.py" "$srcdir/rpd-system-settings"
    python3 "$srcdir/test-settings.py" "$srcdir/rpd-greeter-settings"
}
package() {
    install -Dm755 "$srcdir/rpd-configure-host" "$pkgdir/usr/sbin/rpd-configure-host"
    install -Dm755 "$srcdir/rpd-list-touchscreens" "$pkgdir/usr/bin/rpd-list-touchscreens"
    install -Dm755 "$srcdir/rpd-user-settings" "$pkgdir/usr/bin/rpd-user-settings"
    install -Dm755 "$srcdir/rpd-system-settings" "$pkgdir/usr/libexec/rpd-system-settings"
    install -Dm644 "$srcdir/org.rpd.system-settings.policy" "$pkgdir/usr/share/polkit-1/actions/org.rpd.system-settings.policy"
    install -Dm755 "$srcdir/rpd-apply-greeter" "$pkgdir/usr/bin/rpd-apply-greeter"
    install -Dm755 "$srcdir/rpd-greeter-settings" "$pkgdir/usr/libexec/rpd-greeter-settings"
    install -Dm644 "$srcdir/org.rpd.greeter-settings.policy" "$pkgdir/usr/share/polkit-1/actions/org.rpd.greeter-settings.policy"
}

