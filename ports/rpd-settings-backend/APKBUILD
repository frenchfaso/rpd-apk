pkgname=rpd-settings-backend
pkgver=0.1.0
pkgrel=0
pkgdesc="Portable settings integration for Raspberry Pi Desktop"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="python3 polkit"
source="rpd-apply-greeter rpd-greeter-settings org.rpd.greeter-settings.policy test-settings.py"
check() {
    python3 "$srcdir/test-settings.py" "$srcdir/rpd-greeter-settings"
}
package() {
    install -Dm755 "$srcdir/rpd-apply-greeter" "$pkgdir/usr/bin/rpd-apply-greeter"
    install -Dm755 "$srcdir/rpd-greeter-settings" "$pkgdir/usr/libexec/rpd-greeter-settings"
    install -Dm644 "$srcdir/org.rpd.greeter-settings.policy" "$pkgdir/usr/share/polkit-1/actions/org.rpd.greeter-settings.policy"
}
