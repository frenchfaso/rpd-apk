pkgname=rpd-autorotate
pkgver=0.1.0
pkgrel=2
pkgdesc="Sensor-driven rotation and keyboard policy for convertible desktops"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="python3 py3-gobject3 iio-sensor-proxy wlr-randr dbus squeekboard"
makedepends="python3"
source="touchmap.py test-touchmap.py rotation.py main.py test-rotation.py rpd-autorotate rpd-autorotate-start rpd-autorotate.service rpd-autorotate.desktop"
check() {
    cd "$srcdir"
    python3 test-rotation.py
    python3 test-touchmap.py
}
package() {
    for file in rotation.py main.py touchmap.py; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/lib/rpd-autorotate/$file"
    done
    install -Dm755 "$srcdir/rpd-autorotate" "$pkgdir/usr/bin/rpd-autorotate"
    install -Dm755 "$srcdir/rpd-autorotate-start" "$pkgdir/usr/libexec/rpd-autorotate-start"
    install -Dm644 "$srcdir/rpd-autorotate.service" "$pkgdir/usr/lib/systemd/user/rpd-autorotate.service"
    install -Dm644 "$srcdir/rpd-autorotate.desktop" "$pkgdir/etc/xdg/rpd/autostart/rpd-autorotate.desktop"
}
