+static unsigned
+fd504_tile_mode(const struct pipe_resource *tmpl)
+{
+   /* A504 bypass depth writes use tiled storage.  Keep color resources
+    * linear: enabling general A5xx texture tiling breaks fragment tests.
+    */
+   if (util_format_is_depth_or_stencil(tmpl->format))
+      return fd5_tile_mode(tmpl);
+
+   return 0;
+}
