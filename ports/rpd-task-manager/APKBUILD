prepare() {
    default_prepare
    # Raspberry's V3D-only GPU patch is deliberately excluded.
    test "$(cat "$srcdir/debian/patches/series")" = "$(printf 'gtk3.patch
gpustats.patch')"
    patch -p1 < "$srcdir/debian/patches/gtk3.patch"
    cp -a "$srcdir/debian" .
    autoreconf -fi
}
build() {
    ./configure --prefix=/usr --enable-gtk3
    make
}

package() {
    make DESTDIR="$pkgdir" install
    install -Dm644 debian/copyright "$pkgdir/usr/share/licenses/$pkgname/copyright"
}

