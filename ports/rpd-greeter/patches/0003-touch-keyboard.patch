+    if (wayland)
+    {
+        g_signal_connect_after (password_entry, "button-release-event", G_CALLBACK (password_pressed), NULL);
+        gtk_entry_set_input_purpose (password_entry, GTK_INPUT_PURPOSE_PASSWORD);
+        GtkWidget *keyboard = gtk_button_new_from_icon_name ("input-keyboard-symbolic", GTK_ICON_SIZE_BUTTON);
+        gtk_widget_set_tooltip_text (keyboard, _("On-screen keyboard"));
+        gtk_widget_set_can_focus (keyboard, FALSE);
