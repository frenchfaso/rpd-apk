+/* Keep the keyboard reachable even when a client does not request it. */
+static void show_osk (GtkButton *button, gpointer data)
+{
+    GDBusConnection *bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+    (void) data;
+    if (!button && g_getenv ("RPD_GREETER_PORTRAIT_OSK"))
+    {
+        GdkRectangle geometry;
+        GdkDisplay *display = gtk_widget_get_display (GTK_WIDGET (password_entry));
+        GdkWindow *window = gtk_widget_get_window (GTK_WIDGET (password_entry));
+        GdkMonitor *monitor = window ? gdk_display_get_monitor_at_window (display, window)
+                                    : gdk_display_get_monitor (display, 0);
+        if (!monitor) { if (bus) g_object_unref (bus); return; }
+        gdk_monitor_get_geometry (monitor, &geometry);
+        if (geometry.width >= geometry.height)
+        {
+            if (bus) g_object_unref (bus);
+            return;
+        }
+    }
+    if (!bus) return;
+    gboolean visible = TRUE;
+    /* Read actual visibility, including changes made by autorotation. */
+    if (button)
+    {
+        GVariant *reply = g_dbus_connection_call_sync (bus, "sm.puri.OSK0",
+            "/sm/puri/OSK0", "org.freedesktop.DBus.Properties", "Get",
+            g_variant_new ("(ss)", "sm.puri.OSK0", "Visible"),
+            G_VARIANT_TYPE ("(v)"), G_DBUS_CALL_FLAGS_NONE, 1000, NULL, NULL);
+        if (!reply) { g_object_unref (bus); return; }
+        GVariant *value;
+        g_variant_get (reply, "(v)", &value);
+        visible = !g_variant_get_boolean (value);
+        g_variant_unref (value);
+        g_variant_unref (reply);
+    }
+    /* Disable automatic reopening when the button explicitly hides the OSK. */
+    GSettings *settings = g_settings_new ("org.gnome.desktop.a11y.applications");
+    g_settings_set_boolean (settings, "screen-keyboard-enabled", visible);
+    g_object_unref (settings);
+    g_dbus_connection_call (bus, "sm.puri.OSK0", "/sm/puri/OSK0",
+        "sm.puri.OSK0", "SetVisible", g_variant_new ("(b)", visible),
+        NULL, G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL, NULL);
+    g_object_unref (bus);
+    if (visible) gtk_widget_grab_focus (GTK_WIDGET (password_entry));
+}
+
+static gboolean password_pressed (GtkWidget *widget, GdkEventButton *event, gpointer data)
+{
+    (void) widget;
+    (void) data;
+    if (event->button == GDK_BUTTON_PRIMARY) show_osk (NULL, NULL);
+    return FALSE; /* Preserve normal entry selection and cursor handling. */
+}
