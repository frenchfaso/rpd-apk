+static int estimated_percentage(battery *b)
+{
+    GKeyFile *key = g_key_file_new();
+    GError *error = NULL;
+    int percentage = -1, value;
+    gint64 stamp, now = g_get_real_time() / G_USEC_PER_SEC;
+    if (!g_key_file_load_from_file(key, "/run/rpd-power/estimates.ini", G_KEY_FILE_NONE, &error))
+        goto out;
+    stamp = g_key_file_get_int64(key, b->path, "timestamp", &error);
+    if (error || stamp > now + 5 || stamp < now - 90)
+        goto out;
+    value = g_key_file_get_integer(key, b->path, "percentage", &error);
+    if (!error && value >= 0 && value <= 100) {
+        percentage = value;
+        b->estimated = TRUE;
+        const char *field = b->state && !strcasecmp(b->state, "charging") ?
+                            "time_to_full_at_current_rate" : "time_to_empty";
+        int seconds = g_key_file_get_integer(key, b->path, field, &error);
+        if (!error && seconds >= 0 && seconds <= 604800)
+            b->estimated_seconds = seconds;
+    }
+ out:
+    g_clear_error(&error);
+    g_key_file_free(key);
+    return percentage;
+}
