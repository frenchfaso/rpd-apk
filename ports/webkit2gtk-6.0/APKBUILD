subpackages="$pkgname-dbg $pkgname-lang $pkgname-dev"
source="https://webkitgtk.org/releases/webkitgtk-$pkgver.tar.xz
	cloopfix.patch
	x11-include-order.patch
	verify-build.py
	upstream.json
	"
builddir="$srcdir/webkitgtk-$pkgver"

build() {
	export CC=clang CXX=clang++
	export AR=llvm-ar NM=llvm-nm RANLIB=llvm-ranlib
	export LDFLAGS="$LDFLAGS -fuse-ld=lld"
	# Match the maintained Alpine recipe: bounded unified compilation and no LTO.
	export WEBKIT_NINJA_COMPILE_MAX=1 WEBKIT_NINJA_LINK_MAX=1
	export CFLAGS="$CFLAGS -g1 -U_FORTIFY_SOURCE"
	export CXXFLAGS="$CXXFLAGS -g1 -U_FORTIFY_SOURCE"
	# -U_FORTIFY_SOURCE is the existing Alpine workaround for this upstream build.
	cmake -B build -G Ninja \
		-DPORT=GTK \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_SKIP_RPATH=ON \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DENABLE_DOCUMENTATION=OFF \
		-DENABLE_JOURNALD_LOG=OFF \
		-DENABLE_MINIBROWSER=ON \
		-DENABLE_SAMPLING_PROFILER=OFF \
		-DENABLE_SPELLCHECK=ON \
		-DENABLE_SPEECH_SYNTHESIS=ON \
		-DENABLE_BUBBLEWRAP_SANDBOX=ON \
		-DENABLE_JIT=ON \
		-DENABLE_WEBASSEMBLY=ON \
		-DENABLE_WEBGL=ON \
		-DENABLE_GPU_PROCESS=ON \
		-DENABLE_VIDEO=ON \
		-DENABLE_WEB_AUDIO=ON \
		-DENABLE_MEDIA_SOURCE=ON \
		-DENABLE_WAYLAND_TARGET=ON \
		-DENABLE_X11_TARGET=ON \
		-DUSE_GTK4=ON \
		-DUSE_LIBBACKTRACE=OFF \
		-DUSE_GBM=ON \
		-DUSE_LIBDRM=ON \
		-DUSE_GSTREAMER=ON \
		-DUSE_GSTREAMER_GL=ON \
		-DUSE_GSTREAMER_FULL=OFF \
		-DUSE_SKIA=ON \
		-DUSE_VULKAN=OFF
	# Validate the effective configuration before spending hours compiling it.
	mkdir -p "$startdir/build-evidence"
	python3 "$srcdir/verify-build.py" config build --version "$pkgver" \
		> "$startdir/build-evidence/config.json"
	cp build/cmakeconfig.h build/CMakeCache.txt "$startdir/build-evidence/"
	cmake --build build
}

check() {
	# The release archive omits run-gtk-tests. These are package ABI/configuration
	# checks, not the upstream browser tests or physical GPU/decoder qualification.
	LD_LIBRARY_PATH="$builddir/build/lib" python3 "$srcdir/verify-build.py" runtime \
		--library-dir "$builddir/build/lib" --version "$pkgver" \
		> "$startdir/build-evidence/built-runtime.json"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	mv "$pkgdir"/usr/bin/WebKitWebDriver "$pkgdir"/usr/bin/WebKitWebDriver-6.0
}

