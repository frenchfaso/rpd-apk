#!/bin/sh
set -u
pids=""
start() { "$@" & pids="$pids $!"; }
managed=0
cleanup() {
    trap - EXIT HUP INT TERM
    [ "$managed" = 0 ] || systemctl --user stop rpd-session.target
    [ -z "$pids" ] || kill $pids 2>/dev/null || :
}
trap cleanup EXIT HUP INT TERM
compositor=${LABWC_PID:?labwc must export LABWC_PID}
# Create locale-aware Desktop/Documents/Downloads/etc. without overwriting choices.
xdg-user-dirs-update
# D-Bus-activated GVFS, keyring and portals must inherit this Wayland session.
activation_vars="LANG MUSL_LOCPATH QT_QPA_PLATFORMTHEME XDG_RUNTIME_DIR WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_CONFIG_DIRS XDG_DATA_DIRS XDG_MENU_PREFIX LABWC_PID"
if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd $activation_vars
    managed=1
    systemctl --user start rpd-session.target
    systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service
else
    dbus-update-activation-environment $activation_vars
    [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] || start pipewire
    [ -S "$XDG_RUNTIME_DIR/pulse/native" ] || start pipewire-pulse
    start wireplumber
fi
# Initialise appearance once; later user customisations are preserved.
state=${XDG_STATE_HOME:-$HOME/.local/state}/rpd
if [ ! -f "$state/appearance-initialised" ]; then
    if gsettings set org.gnome.desktop.interface gtk-theme PiXtrix &&
       gsettings set org.gnome.desktop.interface font-name "Nunito Sans Light 12" &&
       gsettings set org.gnome.desktop.interface icon-theme PiXtrix &&
       gsettings set org.gnome.desktop.interface cursor-theme PiXtrix &&
       gsettings set org.gnome.desktop.interface cursor-size 24; then
        mkdir -p "$state"
        touch "$state/appearance-initialised"
    fi
fi
if [ "$managed" = 1 ]; then systemctl --user start rpd-polkit.service; else start /usr/libexec/polkit-mate-authentication-agent-1; fi
if [ "$managed" = 1 ]; then systemctl --user start rpd-panel.service; else start wf-panel-pi; fi
start pcmanfm --desktop
start squeekboard
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd"
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf" ] || cp /etc/xdg/rpd/xsettingsd/xsettingsd.conf "${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/"
start xsettingsd -c "${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf"
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/kanshi/config" ]; then
    if [ "$managed" = 1 ]; then systemctl --user start rpd-kanshi.service; else start kanshi; fi
fi
# Same XDG autostart runner as Raspberry Pi OS; honours per-user overrides.
if [ "$managed" = 1 ]; then
    start systemd-run --user --scope --unit=rpd-autostart --property=PartOf=rpd-session.target lxsession-xdg-autostart
else
    start lxsession-xdg-autostart
fi
# The autostart shell may exit before the compositor, so use LABWC_PID.
while kill -0 "$compositor" 2>/dev/null; do sleep 2; done
