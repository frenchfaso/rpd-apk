#!/bin/sh
set -u
pids=""
start() { "$@" & pids="$pids $!"; }
cleanup() { trap - EXIT HUP INT TERM; [ -z "$pids" ] || kill $pids 2>/dev/null || :; }
trap cleanup EXIT HUP INT TERM
start wf-panel-pi
start pcmanfm --desktop
start squeekboard
start nm-applet --indicator
start /usr/libexec/polkit-gnome-authentication-agent-1
# labwc invokes autostart with the compositor as parent. Exit with it.
compositor=$PPID
while kill -0 "$compositor" 2>/dev/null; do sleep 2; done
