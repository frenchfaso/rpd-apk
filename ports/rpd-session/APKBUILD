pkgname=rpd-session
pkgver=0.1.0
pkgrel=52
pkgdesc="Portable Raspberry Pi Desktop session and defaults"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="python3 wayvnc gsettings-desktop-schemas labwc dbus lxsession gnome-keyring gnome-keyring-pam xdg-user-dirs xsettingsd dconf pipewire pipewire-pulse wireplumber kanshi swayidle wlopm xdg-desktop-portal-gtk xdg-desktop-portal-wlr squeekboard>=1.43.1-r100 network-manager-applet mate-polkit polkit mousepad"
options="!check"
source="rpd-screen-power 90-rpd-desktop-audio.conf rpd-idle rpd-idle.service rpd-reload-displays rpd-kanshi.service lxsession-default-apps.desktop rpd-polkit.service lxpolkit.desktop polkit-mate-authentication-agent-1.desktop desktop-items-0.conf rpd-panel.service pipewire.desktop rpd-session.target xsettingsd.conf labwc-portals.conf nm-applet.desktop rpd-edit-launcher rpd-session rpd-autostart rpd-session-services rpd-panel-settings rpd-session.desktop wf-panel-pi.ini rc.xml settings.ini"
package() {
    install -Dm755 "$srcdir/rpd-screen-power" "$pkgdir/usr/bin/rpd-screen-power"
    install -Dm644 "$srcdir/90-rpd-desktop-audio.conf" "$pkgdir/etc/xdg/rpd/wireplumber/wireplumber.conf.d/90-rpd-desktop-audio.conf"
    install -Dm755 "$srcdir/rpd-idle" "$pkgdir/usr/libexec/rpd-idle"
    install -Dm644 "$srcdir/rpd-idle.service" "$pkgdir/usr/lib/systemd/user/rpd-idle.service"
    install -Dm755 "$srcdir/rpd-reload-displays" "$pkgdir/usr/bin/rpd-reload-displays"
    install -Dm644 "$srcdir/rpd-kanshi.service" "$pkgdir/usr/lib/systemd/user/rpd-kanshi.service"
    install -Dm644 "$srcdir/lxsession-default-apps.desktop" "$pkgdir/usr/share/raspi-ui-overrides/applications/lxsession-default-apps.desktop"
    install -Dm644 "$srcdir/rpd-polkit.service" "$pkgdir/usr/lib/systemd/user/rpd-polkit.service"
    install -Dm644 "$srcdir/lxpolkit.desktop" "$pkgdir/etc/xdg/rpd/autostart/lxpolkit.desktop"
    install -Dm644 "$srcdir/polkit-mate-authentication-agent-1.desktop" "$pkgdir/etc/xdg/rpd/autostart/polkit-mate-authentication-agent-1.desktop"
    install -Dm644 "$srcdir/desktop-items-0.conf" "$pkgdir/etc/xdg/rpd/pcmanfm/default/desktop-items-0.conf"
    install -Dm644 "$srcdir/rpd-panel.service" "$pkgdir/usr/lib/systemd/user/rpd-panel.service"
    install -Dm644 "$srcdir/pipewire.desktop" "$pkgdir/etc/xdg/rpd/autostart/pipewire.desktop"
    install -Dm644 "$srcdir/rpd-session.target" "$pkgdir/usr/lib/systemd/user/rpd-session.target"
    install -Dm644 "$srcdir/xsettingsd.conf" "$pkgdir/etc/xdg/rpd/xsettingsd/xsettingsd.conf"
    install -Dm644 "$srcdir/labwc-portals.conf" "$pkgdir/etc/xdg/rpd/xdg-desktop-portal/labwc-portals.conf"
    install -Dm644 "$srcdir/nm-applet.desktop" "$pkgdir/etc/xdg/rpd/autostart/nm-applet.desktop"
    install -Dm755 "$srcdir/rpd-edit-launcher" "$pkgdir/usr/bin/rpd-edit-launcher"
    install -Dm755 "$srcdir/rpd-session" "$pkgdir/usr/bin/rpd-session"
    install -Dm755 "$srcdir/rpd-panel-settings" "$pkgdir/usr/bin/rpd-panel-settings"
    install -Dm755 "$srcdir/rpd-session-services" "$pkgdir/usr/libexec/rpd-session-services"
    install -Dm755 "$srcdir/rpd-autostart" "$pkgdir/etc/xdg/rpd/labwc/autostart"
    install -Dm644 "$srcdir/rc.xml" "$pkgdir/etc/xdg/rpd/labwc/rc.xml"
    install -Dm644 "$srcdir/settings.ini" "$pkgdir/etc/xdg/rpd/gtk-3.0/settings.ini"
    install -Dm644 "$srcdir/wf-panel-pi.ini" "$pkgdir/etc/xdg/rpd/wf-panel-pi/wf-panel-pi.ini"
    install -Dm644 "$srcdir/rpd-session.desktop" "$pkgdir/usr/share/wayland-sessions/rpd-session.desktop"
}

