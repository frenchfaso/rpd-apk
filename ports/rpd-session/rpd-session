#!/bin/sh
set -eu
export XDG_CURRENT_DESKTOP=labwc
export XDG_SESSION_TYPE=wayland
export XDG_CONFIG_DIRS=/etc/xdg/rpd:${XDG_CONFIG_DIRS:-/etc/xdg}
export XDG_MENU_PREFIX=rpd-
export XDG_DATA_DIRS=/usr/share/raspi-ui-overrides:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
locale_file=${XDG_CONFIG_HOME:-$HOME/.config}/rpd/locale.conf
if [ -r "$locale_file" ]; then
    while IFS='=' read -r key value; do
        [ "$key" != LANG ] || export LANG="$value"
    done < "$locale_file"
    unset LC_ALL LANGUAGE
fi
export MUSL_LOCPATH=/usr/share/i18n/locales/musl
export QT_QPA_PLATFORMTHEME=gtk2
export XCURSOR_THEME=PiXtrix
export XCURSOR_SIZE=24
# Explicit opt-in software rendering; do not impose it on other hardware.
if [ "${RPD_SOFTWARE_RENDERING:-0}" = 1 ]; then
    export WLR_RENDERER=pixman
    export LIBGL_ALWAYS_SOFTWARE=1
fi
# A per-user copy lets upstream appearance/input/shortcut editors work normally.
config=${RPD_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/labwc}
mkdir -p "$config"
for file in rc.xml autostart; do
    [ -f "$config/$file" ] || cp "/etc/xdg/rpd/labwc/$file" "$config/$file"
done
# Ensure touchscreen output mapping and base calibration before starting labwc.
if [ -f /etc/xdg/rpd/autorotate.conf ] && command -v rpd-autorotate >/dev/null; then
    RPD_CONFIG_DIR="$config" rpd-autorotate --reset-touch
    # Seed the compositor from the greeter's sensor snapshot without shell eval.
    unset RPD_INITIAL_OUTPUT RPD_INITIAL_TRANSFORM
    if initial=$(timeout 5 rpd-autorotate --initial-env); then
        read -r RPD_INITIAL_OUTPUT RPD_INITIAL_TRANSFORM <<EOF
$initial
EOF
        case "$RPD_INITIAL_TRANSFORM" in
            normal|90|180|270) export RPD_INITIAL_OUTPUT RPD_INITIAL_TRANSFORM ;;
            *) unset RPD_INITIAL_OUTPUT RPD_INITIAL_TRANSFORM ;;
        esac
    fi
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- labwc --config-dir "$config" "$@"
fi
exec labwc --config-dir "$config" "$@"
