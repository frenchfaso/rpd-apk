+
+/* Native Wayland touches are not GDK_2BUTTON_PRESS events. Let GTK count
+ * taps with its configured time/distance thresholds, for touch input only. */
+static void on_desktop_double_tap(GtkGestureMultiPress *gesture, gint n_press,
+                                  gdouble x, gdouble y, FmDesktop *self)
+{
+    GtkTreeIter it;
+    gboolean in_text;
+    FmDesktopItem *item;
+    GtkTreePath *path;
+
+    if (n_press != 2 || fm_config->single_click || !self->model)
+        return;
+    item = hit_test(self, &it, x, y, &in_text);
+    if (!item)
+        return;
+    path = gtk_tree_model_get_path(GTK_TREE_MODEL(self->model), &it);
+    gtk_gesture_set_state(GTK_GESTURE(gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+    fm_folder_view_item_clicked(FM_FOLDER_VIEW(self), path, FM_FV_ACTIVATED, 0, -1, -1);
+    gtk_tree_path_free(path);
 }
 
 static void on_desktop_gesture_pressed (GtkGestureLongPress *, gdouble x, gdouble y, FmDesktop *self)
