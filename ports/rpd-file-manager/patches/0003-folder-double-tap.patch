+/* Handle native touch independently from mouse double-click events. */
+static void on_view_double_tap(GtkGestureMultiPress *gesture, gint n_press,
+                               gdouble x, gdouble y, FmStandardView *fv)
+{
+    GtkTreePath *path = NULL;
+
+    if (n_press != 2 || fm_config->single_click || !fv->model)
+        return;
+    if (fv->mode == FM_FV_LIST_VIEW)
+    {
+        gint bx, by;
+        gtk_tree_view_convert_widget_to_bin_window_coords(GTK_TREE_VIEW(fv->view),
+                                                          x, y, &bx, &by);
+        gtk_tree_view_get_path_at_pos(GTK_TREE_VIEW(fv->view), bx, by,
+                                      &path, NULL, NULL, NULL);
+    }
+    else
+        path = exo_icon_view_get_path_at_pos(EXO_ICON_VIEW(fv->view), x, y);
+    if (!path)
+        return;
+    if (fv->mode == FM_FV_LIST_VIEW)
+        exo_tree_view_clear_rename(EXO_TREE_VIEW(fv->view));
+    else
+        exo_icon_view_clear_rename(EXO_ICON_VIEW(fv->view));
+    gtk_gesture_set_state(GTK_GESTURE(gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+    fm_folder_view_item_clicked(FM_FOLDER_VIEW(fv), path, FM_FV_ACTIVATED, 0, -1, -1);
+    gtk_tree_path_free(path);
+}
+
+static void setup_view_double_tap(FmStandardView *fv)
+{
+    fv->double_tap = gtk_gesture_multi_press_new(fv->view);
+    gtk_gesture_single_set_touch_only(GTK_GESTURE_SINGLE(fv->double_tap), TRUE);
+    g_signal_connect(fv->double_tap, "pressed", G_CALLBACK(on_view_double_tap), fv);
+    gtk_event_controller_set_propagation_phase(GTK_EVENT_CONTROLLER(fv->double_tap),
+                                               GTK_PHASE_CAPTURE);
+}
