pkgname=rpd-backlight-m10
pkgver=7.1.3
pkgrel=52
pkgdesc="Firmware DSI backlight for verified Lenovo M10 INX JD9365 panels"
url="https://github.com/frenchfaso/rpd-apk"
arch="aarch64"
license="GPL-2.0-only"
subpackages="rpd-usb-otg-m10:otg rpd-battery-m10:battery rpd-charger-m10:charger rpd-audio-m10:audio"
install="rpd-audio-m10.post-install rpd-audio-m10.post-upgrade rpd-audio-m10.post-deinstall rpd-charger-m10.post-install rpd-charger-m10.post-upgrade rpd-charger-m10.pre-deinstall rpd-backlight-m10.post-install rpd-backlight-m10.post-upgrade rpd-usb-otg-m10.post-install rpd-usb-otg-m10.post-upgrade rpd-usb-otg-m10.pre-deinstall rpd-battery-m10.post-install rpd-battery-m10.post-upgrade rpd-battery-m10.pre-deinstall"
_kernel_apk_version=7.1.3-r0
depends="kmod brightnessctl brightnessctl-udev"
makedepends="clang22 lld22 llvm22 make flex bison perl openssl-dev elfutils-dev pahole python3 py3-libfdt dtc rpd-cpu-topology-m10"
source="m10_wcd_analog.c m10_speaker_amp.c m10-audio-pmic.diff m10-audio.dtsi audio-dtb.py test-audio.py 95-rpd-audio-m10 Lenovo-M10.conf HiFi.conf 51-rpd-m10-audio.conf m10_charger.c m10_charger_transaction.h test-charger.c rpd-charger-m10-load rpd-charger-m10.service 80-rpd-charger-m10.preset 80-rpd-battery-m10.preset linux-v7.1.3-r1.tar.gz::https://github.com/msm89x7-mainline/linux/archive/refs/tags/v7.1.3-r1.tar.gz
    kernel.config Makefile m10_firmware_backlight.c
    rpd-backlight-m10.service rpd-backlight-m10-load
    m10_otg_id.c m10_otg_vbus.c rpd-usb-otg-m10 rpd-usb-otg-m10.service test-otg.py 80-rpd-usb-otg-m10.preset
    m10_battery.c m10_battery_temperature.h m10-adc5-battery.diff rpd-battery-m10-load rpd-battery-m10.service"
builddir="$srcdir/linux-7.1.3-r1"

build() {
    unset LDFLAGS
    export PATH=/usr/lib/llvm22/bin:$PATH
    cp "$srcdir/kernel.config" .config
    make LLVM=1 olddefconfig
    # Native userspace-link capability does not affect the kernel ABI.
    sed '/^CONFIG_CC_CAN_LINK=y$/d' .config > "$srcdir/config.normalized"
    sed '/^CONFIG_CC_CAN_LINK=y$/d' "$srcdir/kernel.config" > "$srcdir/config.expected"
    diff -u "$srcdir/config.expected" "$srcdir/config.normalized"
    # Generate real export metadata, never suppress modpost errors.
    make LLVM=1 -j2 vmlinux
    cp vmlinux.symvers Module.symvers
    # vmlinux alone does not generate scripts/module.lds for external modules.
    make LLVM=1 modules_prepare
    mkdir -p "$srcdir/backlight-module"
    cp "$srcdir/Makefile" "$srcdir/m10_firmware_backlight.c" "$srcdir/m10_otg_id.c" "$srcdir/m10_otg_vbus.c" "$srcdir/backlight-module/"
    cp "$srcdir/m10_charger.c" "$srcdir/m10_charger_transaction.h" "$srcdir/backlight-module/"
    cp "$srcdir/m10_battery.c" "$srcdir/m10_battery_temperature.h" "$srcdir/backlight-module/"
    cp drivers/iio/adc/qcom-spmi-adc5.c "$srcdir/backlight-module/m10_adc5_battery.c"
    # .diff avoids abuild applying this to the kernel during default_prepare.
    # Only the standalone module copy receives the battery ADC changes.
    patch -d "$srcdir/backlight-module" -p0 < "$srcdir/m10-adc5-battery.diff"
    cp "$srcdir/m10_wcd_analog.c" "$srcdir/m10_speaker_amp.c" "$srcdir/backlight-module/"
    cp drivers/mfd/qcom-spmi-pmic.c "$srcdir/backlight-module/m10_audio_pmic.c"
    patch -d "$srcdir/backlight-module" -p0 < "$srcdir/m10-audio-pmic.diff"
    make LLVM=1 M="$srcdir/backlight-module" modules
    # Build from this kernel's board source; never ship an old full board tree.
    make LLVM=1 qcom/sdm429-lenovo-tbx505x.dtb
    cp arch/arm64/boot/dts/qcom/sdm429-lenovo-tbx505x.dtb "$srcdir/base.dtb"
    printf '%s\n' '#include "sdm429-lenovo-tbx505x.dts"' '#include "m10-audio.dtsi"' > "$srcdir/audio.dts"
    clang -E -nostdinc -undef -D__DTS__ -x assembler-with-cpp \
        -Iscripts/dtc/include-prefixes -Iarch/arm64/boot/dts/qcom -I"$srcdir" \
        "$srcdir/audio.dts" -o "$srcdir/audio.pp.dts"
    dtc -I dts -O dtb -o "$srcdir/audio.dtb" "$srcdir/audio.pp.dts"
}

check() {
    export PATH=/usr/lib/llvm22/bin:$PATH
    test "$(make -s LLVM=1 kernelrelease)" = 7.1.3-msm89x7
    test -s vmlinux.symvers
    # Every module import must resolve against the verified kernel exports.
    llvm-nm -u "$srcdir/backlight-module/"*.ko > "$srcdir/imports"
    python3 - "$srcdir/imports" Module.symvers <<'PY'
import sys
imports={s.split()[-1] for s in open(sys.argv[1]) if s.strip() and not s.rstrip().endswith(':')}
exports={s.split()[1] for s in open(sys.argv[2]) if s.strip()}
missing=imports-exports
assert not missing, f'Unresolved kernel exports: {sorted(missing)}'
PY
    clang -std=c11 -Wall -Wextra -Werror "$srcdir/test-charger.c" -o "$srcdir/test-charger"
    "$srcdir/test-charger"
    sh -n "$srcdir/rpd-backlight-m10-load"
    python3 "$srcdir/test-otg.py"
    python3 "$srcdir/test-audio.py" "$srcdir/base.dtb" "$srcdir/audio.dtb"
}

package() {
    install -Dm644 "$srcdir/backlight-module/m10_firmware_backlight.ko" \
        "$pkgdir/usr/lib/modules/7.1.3-msm89x7/extra/m10_firmware_backlight.ko"
    install -Dm644 "$srcdir/rpd-backlight-m10.service" \
        "$pkgdir/usr/lib/systemd/system/rpd-backlight-m10.service"
    install -Dm755 "$srcdir/rpd-backlight-m10-load" \
        "$pkgdir/usr/libexec/rpd-backlight-m10-load"
}


otg() {
    pkgdesc="Automatic passive USB OTG for Lenovo M10 (500mA)"
    depends="python3 kmod"
    for module in m10_otg_id m10_otg_vbus; do
        install -Dm644 "$srcdir/backlight-module/$module.ko" \
            "$subpkgdir/usr/lib/modules/$pkgver-msm89x7/extra/$module.ko"
    done
    install -Dm755 "$srcdir/rpd-usb-otg-m10" "$subpkgdir/usr/libexec/rpd-usb-otg-m10"
    install -Dm644 "$srcdir/rpd-usb-otg-m10.service" "$subpkgdir/usr/lib/systemd/system/rpd-usb-otg-m10.service"
    install -Dm644 "$srcdir/80-rpd-usb-otg-m10.preset" "$subpkgdir/usr/lib/systemd/system-preset/80-rpd-usb-otg-m10.preset"
    mkdir -p "$subpkgdir/usr/lib/rpd-usb-otg-m10"
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" \
        > "$subpkgdir/usr/lib/rpd-usb-otg-m10/kernel.json"
}


battery() {
    install -Dm644 "$srcdir/80-rpd-battery-m10.preset" "$subpkgdir/usr/lib/systemd/system-preset/80-rpd-battery-m10.preset"
    pkgdesc="Lenovo M10 battery current, voltage and OEM thermistor telemetry"
    depends="python3 kmod rpd-battery>=1.11-r23"
    for module in m10_battery m10_adc5_battery; do
        install -Dm644 "$srcdir/backlight-module/$module.ko" \
            "$subpkgdir/usr/lib/modules/$pkgver-msm89x7/extra/$module.ko"
    done
    install -Dm755 "$srcdir/rpd-battery-m10-load" "$subpkgdir/usr/libexec/rpd-battery-m10-load"
    install -Dm644 "$srcdir/rpd-battery-m10.service" "$subpkgdir/usr/lib/systemd/system/rpd-battery-m10.service"
    mkdir -p "$subpkgdir/usr/lib/rpd-battery-m10"
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" \
        > "$subpkgdir/usr/lib/rpd-battery-m10/kernel.json"
}


charger() {
    pkgdesc="Guarded Lenovo M10 OEM charge-termination threshold"
    depends="python3 kmod rpd-battery-m10=$pkgver-r$pkgrel"
    install -Dm644 "$srcdir/backlight-module/m10_charger.ko" \
        "$subpkgdir/usr/lib/modules/$pkgver-msm89x7/extra/m10_charger.ko"
    install -Dm755 "$srcdir/rpd-charger-m10-load" "$subpkgdir/usr/libexec/rpd-charger-m10-load"
    install -Dm644 "$srcdir/rpd-charger-m10.service" "$subpkgdir/usr/lib/systemd/system/rpd-charger-m10.service"
    install -Dm644 "$srcdir/80-rpd-charger-m10.preset" "$subpkgdir/usr/lib/systemd/system-preset/80-rpd-charger-m10.preset"
    mkdir -p "$subpkgdir/usr/lib/rpd-charger-m10"
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" \
        > "$subpkgdir/usr/lib/rpd-charger-m10/kernel.json"
}

audio() {
    pkgdesc="Lenovo M10 PM8953 internal stereo speakers"
    depends="kmod python3 py3-libfdt alsa-ucm-conf rpd-cpu-topology-m10"
    for module in m10_audio_pmic m10_wcd_analog m10_speaker_amp; do
        install -Dm644 "$srcdir/backlight-module/$module.ko" \
            "$subpkgdir/usr/lib/modules/$pkgver-msm89x7/extra/$module.ko"
    done
    for file in audio-dtb.py base.dtb audio.dtb; do
        install -Dm644 "$srcdir/$file" "$subpkgdir/usr/lib/rpd-audio-m10/$file"
    done
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" \
        > "$subpkgdir/usr/lib/rpd-audio-m10/kernel.json"
    install -Dm755 "$srcdir/95-rpd-audio-m10" "$subpkgdir/usr/share/boot-deploy/hooks/95-rpd-audio-m10"
    install -Dm644 "$srcdir/Lenovo-M10.conf" "$subpkgdir/usr/share/alsa/ucm2/conf.d/Lenovo-M10/Lenovo-M10.conf"
    install -Dm644 "$srcdir/HiFi.conf" "$subpkgdir/usr/share/alsa/ucm2/Lenovo/M10/HiFi.conf"
    install -Dm644 "$srcdir/51-rpd-m10-audio.conf" "$subpkgdir/etc/wireplumber/wireplumber.conf.d/51-rpd-m10-audio.conf"
    mkdir -p "$subpkgdir/usr/share/mkinitfs-triggers"
    touch "$subpkgdir/usr/share/mkinitfs-triggers/rpd-audio-m10"
}

