pkgname=rpd-backlight-m10
pkgver=7.1.3
pkgrel=5
pkgdesc="Firmware DSI backlight for verified Lenovo M10 INX JD9365 panels"
url="https://github.com/frenchfaso/rpd-apk"
arch="aarch64"
license="GPL-2.0-only"
subpackages="rpd-usb-otg-m10:otg"
install="rpd-backlight-m10.post-install rpd-backlight-m10.post-upgrade rpd-usb-otg-m10.post-install rpd-usb-otg-m10.post-upgrade rpd-usb-otg-m10.pre-deinstall"
_kernel_apk_version=7.1.3-r0
depends="kmod brightnessctl brightnessctl-udev"
makedepends="clang22 lld22 llvm22 make flex bison perl openssl-dev elfutils-dev pahole python3"
source="linux-v7.1.3-r1.tar.gz::https://github.com/msm89x7-mainline/linux/archive/refs/tags/v7.1.3-r1.tar.gz
    kernel.config Makefile m10_firmware_backlight.c
    rpd-backlight-m10.service rpd-backlight-m10-load
    m10_otg_id.c m10_otg_vbus.c rpd-usb-otg-m10 rpd-usb-otg-m10.service test-otg.py 80-rpd-usb-otg-m10.preset"
builddir="$srcdir/linux-7.1.3-r1"

build() {
    unset LDFLAGS
    export PATH=/usr/lib/llvm22/bin:$PATH
    cp "$srcdir/kernel.config" .config
    make LLVM=1 olddefconfig
    # Native userspace-link capability does not affect the kernel ABI.
    sed '/^CONFIG_CC_CAN_LINK=y$/d' .config > "$srcdir/config.normalized"
    sed '/^CONFIG_CC_CAN_LINK=y$/d' "$srcdir/kernel.config" > "$srcdir/config.expected"
    diff -u "$srcdir/config.expected" "$srcdir/config.normalized"
    # Generate real export metadata, never suppress modpost errors.
    make LLVM=1 -j2 vmlinux
    cp vmlinux.symvers Module.symvers
    # vmlinux alone does not generate scripts/module.lds for external modules.
    make LLVM=1 modules_prepare
    mkdir -p "$srcdir/backlight-module"
    cp "$srcdir/Makefile" "$srcdir/m10_firmware_backlight.c" "$srcdir/m10_otg_id.c" "$srcdir/m10_otg_vbus.c" "$srcdir/backlight-module/"
    make LLVM=1 M="$srcdir/backlight-module" modules
}

check() {
    export PATH=/usr/lib/llvm22/bin:$PATH
    test "$(make -s LLVM=1 kernelrelease)" = 7.1.3-msm89x7
    test -s vmlinux.symvers
    # Every module import must resolve against the verified kernel exports.
    llvm-nm -u "$srcdir/backlight-module/"*.ko > "$srcdir/imports"
    python3 - "$srcdir/imports" Module.symvers <<'PY'
import sys
imports={s.split()[-1] for s in open(sys.argv[1]) if s.strip() and not s.rstrip().endswith(':')}
exports={s.split()[1] for s in open(sys.argv[2]) if s.strip()}
missing=imports-exports
assert not missing, f'Unresolved kernel exports: {sorted(missing)}'
PY
    sh -n "$srcdir/rpd-backlight-m10-load"
    python3 "$srcdir/test-otg.py"
}

package() {
    install -Dm644 "$srcdir/backlight-module/m10_firmware_backlight.ko" \
        "$pkgdir/usr/lib/modules/7.1.3-msm89x7/extra/m10_firmware_backlight.ko"
    install -Dm644 "$srcdir/rpd-backlight-m10.service" \
        "$pkgdir/usr/lib/systemd/system/rpd-backlight-m10.service"
    install -Dm755 "$srcdir/rpd-backlight-m10-load" \
        "$pkgdir/usr/libexec/rpd-backlight-m10-load"
}


otg() {
    pkgdesc="Automatic passive USB OTG for Lenovo M10 (500mA)"
    depends="python3 kmod"
    for module in m10_otg_id m10_otg_vbus; do
        install -Dm644 "$srcdir/backlight-module/$module.ko" \
            "$subpkgdir/usr/lib/modules/$pkgver-msm89x7/extra/$module.ko"
    done
    install -Dm755 "$srcdir/rpd-usb-otg-m10" "$subpkgdir/usr/libexec/rpd-usb-otg-m10"
    install -Dm644 "$srcdir/rpd-usb-otg-m10.service" "$subpkgdir/usr/lib/systemd/system/rpd-usb-otg-m10.service"
    install -Dm644 "$srcdir/80-rpd-usb-otg-m10.preset" "$subpkgdir/usr/lib/systemd/system-preset/80-rpd-usb-otg-m10.preset"
    mkdir -p "$subpkgdir/usr/lib/rpd-usb-otg-m10"
    printf '{"release":"%s-msm89x7","apk":"%s"}\n' "$pkgver" "$_kernel_apk_version" \
        > "$subpkgdir/usr/lib/rpd-usb-otg-m10/kernel.json"
}

