+static bool a504_progress(struct msm_gpu *gpu, struct msm_ringbuffer *ring)
+{
+	struct a5xx_gpu *a5xx_gpu = to_a5xx_gpu(to_adreno_gpu(gpu));
+	u64 count;
+	bool progress;
+
+	/* SP0 is reserved at init; sample only its RBBM counter mirror here. */
+
+	/*
+	 * A long fragment-discard draw can make forward progress without
+	 * advancing the CP. This activity is not a termination guarantee:
+	 * the common hangcheck still enforces its three-retry hard bound.
+	 * Counts may include another ring; at worst that consumes a bounded
+	 * extra retry, just as a first CP snapshot can do.
+	 */
+	count = gpu_read64(gpu, REG_A5XX_RBBM_PERFCTR_SP_0_LO);
+	progress = count != a5xx_gpu->last_discard_count[ring->id];
+	a5xx_gpu->last_discard_count[ring->id] = count;
+
+	return progress;
+}
