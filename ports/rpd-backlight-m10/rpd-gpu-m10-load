#!/usr/bin/python3
"""Load a matched GPU extension or defer to the installed upstream driver."""
import json
from pathlib import Path
import subprocess


def run(*args):
    subprocess.run(args, check=True, timeout=30)


def main():
    data = Path('/usr/lib/rpd-gpu-m10')
    metadata = json.loads((data / 'kernel.json').read_text())
    running = subprocess.check_output(['uname', '-r'], text=True).strip()
    matched = subprocess.run(['apk', 'info', '-e',
        'linux-postmarketos-qcom-msm89x7=' + metadata['apk']],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if running != metadata['release'] or not matched:
        print('rpd-gpu-m10: kernel changed; using upstream modules')
        run('modprobe', 'msm', 'separate_gpu_kms=1')
        return
    gpu = Path('/proc/device-tree/soc@0/gpu@1c00000')
    if (gpu / 'compatible').read_bytes().split(b'\0')[0] != b'qcom,adreno-504.0':
        print('rpd-gpu-m10: matching GPU DT not active; reboot after installation')
        return
    # Never unload live graphics modules or replace official module files.
    if Path('/sys/module/msm').exists():
        print('rpd-gpu-m10: driver already loaded')
        return
    if not Path('/sys/module/ubwc_config').exists():
        run('insmod', str(data / 'ubwc_config.ko'))
    for dependency in ('drm_exec', 'drm_gpuvm', 'gpu-sched', 'mdt_loader',
                       'drm_display_helper'):
        run('modprobe', dependency)
    run('insmod', str(data / 'msm.ko'), 'separate_gpu_kms=1')


if __name__ == '__main__':
    main()
