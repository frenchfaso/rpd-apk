+
+#include <linux/pm_domain.h>
 
 #include "adreno_gpu.h"
 
@@ -271,6 +273,32 @@
 
 static int adreno_probe(struct platform_device *pdev)
 {
+	struct device *dev = &pdev->dev;
+	int ret;
+
+	/* A504 has a GCC power switch and a separate RPM voltage domain. */
+	if (of_device_is_compatible(dev->of_node, "qcom,adreno-504.0") &&
+	    of_count_phandle_with_args(dev->of_node, "power-domains",
+				      "#power-domain-cells") > 1) {
+		static const char * const pd_names[] = { "cx", "gx" };
+		const struct dev_pm_domain_attach_data pd_data = {
+			.pd_names = pd_names,
+			.num_pd_names = ARRAY_SIZE(pd_names),
+		};
+		struct dev_pm_domain_list *pds;
+		struct dev_pm_opp_config opp_config = {};
+
+		ret = devm_pm_domain_attach_list(dev, &pd_data, &pds);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "Failed to attach GPU power domains\n");
+
+		opp_config.required_dev = pds->pd_devs[0];
+		opp_config.required_dev_index = 0;
+		ret = devm_pm_opp_set_config(dev, &opp_config);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "Failed to associate GPU voltage OPPs\n");
+	}
+
 	if (of_device_is_compatible(pdev->dev.of_node, "amd,imageon") ||
 	    msm_gpu_no_components())
 		return msm_gpu_probe(pdev, &a3xx_ops);
