+    /// Explicit desktop show survives both focus and terminal destruction.
+    #[test]
+    fn desktop_show_survives_terminal_exit() {
+        let now = Instant::now();
+        let mut state = Application {
+            persistent_visibility: true,
+            ..application_with_fake_output(now)
+        }.apply_event(Event::Visibility(visibility::Event::ForceVisible), now);
+        for _ in 0..3 {
+            state = state.apply_event(Event::InputMethod(InputMethod::Active(imdetails_new())), now);
+            state = state.apply_event(Event::InputMethod(InputMethod::InactiveSince(now)), now);
+            assert_matches!(state.get_outcome(now + Duration::from_secs(1)).panel,
+                animation::Outcome::Visible{..});
+        }
+        // A subsequent panel toggle or landscape transition still hides it.
+        state = state.apply_event(Event::Visibility(visibility::Event::ForceHidden), now);
+        assert_eq!(state.get_outcome(now).panel, animation::Outcome::Hidden);
+    }
+
+    #[test]
+    fn desktop_hide_survives_focus_changes() {
+        let now = Instant::now();
+        let mut state = Application {
+            persistent_visibility: true,
+            ..application_with_fake_output(now)
+        }.apply_event(Event::Visibility(visibility::Event::ForceHidden), now);
+        state = state.apply_event(Event::InputMethod(InputMethod::Active(imdetails_new())), now);
+        assert_eq!(state.get_outcome(now).panel, animation::Outcome::Hidden);
+        state = state.apply_event(Event::InputMethod(InputMethod::InactiveSince(now)), now);
+        assert_eq!(state.get_outcome(now).panel, animation::Outcome::Hidden);
+        state = state.apply_event(Event::Visibility(visibility::Event::ForceVisible), now);
+        assert_matches!(state.get_outcome(now).panel, animation::Outcome::Visible{..});
+    }
+
+    #[test]
+    fn desktop_unforced_input_still_hides() {
+        let now = Instant::now();
+        let state = Application {
+            persistent_visibility: true,
+            ..application_with_fake_output(now)
+        }.apply_event(Event::InputMethod(InputMethod::Active(imdetails_new())), now)
+            .apply_event(Event::InputMethod(InputMethod::InactiveSince(now)), now);
+        assert_eq!(state.get_outcome(now + Duration::from_secs(1)).panel,
+            animation::Outcome::Hidden);
+    }
