# Contributor: Bart Ribbers <bribbers@disroot.org>
# Contributor: Danct12 <danct12@disroot.org>
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Based on Alpine community/squeekboard 1.43.1-r5 (team/phosh).
# Local patch is opt-in; the greeter retains upstream visibility behavior.
pkgname=squeekboard
pkgver=1.43.1
pkgrel=114
pkgdesc="The final Phosh keyboard"
# loongarch64: nix error: sys/ioctl/linux.rs:51: could not find `consts` in `self`
# s390x: fails with nix/libc errors
arch="aarch64"
url="https://gitlab.gnome.org/World/Phosh/squeekboard"
license="GPL-3.0-or-later"
makedepends="
	bash
	cargo
	feedbackd-dev
	glib-dev
	gnome-desktop-dev
	gtk+3.0-dev
	libbsd-dev
	meson
	ninja
	rust
	wayland-dev
	wayland-protocols
	"
checkdepends="xvfb-run"
options="net"
subpackages="$pkgname-lang $pkgname-systemd"
source="https://gitlab.gnome.org/World/Phosh/squeekboard/-/archive/v$pkgver/squeekboard-v$pkgver.tar.gz
	sm.puri.OSK0.desktop
	systemd-service.patch
	nix-0.22.3-timespec.patch
	persistent-visibility.patch
	"
builddir="$srcdir/$pkgname-v$pkgver"

provides="phosh-keyboard=0"
provider_priority=10
replaces="phosh"

prepare() {
	# Temporarily vendor to patch nix crate
	cargo vendor --locked

	mkdir -p .cargo
	cat >> .cargo/config.toml <<-EOF
		[source.crates-io]
		replace-with = "vendored-sources"

		[source.vendored-sources]
		directory = "vendor"
	EOF
	sed -i 's/\("files":{\)[^}]*/\1/' vendor/nix/.cargo-checksum.json

	default_prepare
	# Preserve exact Rust dependencies with our other published source archives.
	tar -czf "$SRCDEST/squeekboard-vendor-$pkgver.tar.gz" vendor
}

build() {
	abuild-meson \
		-Db_lto=true \
		-Dstrict=false \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test --print-errorlogs -C output -t 10
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -D -m644 "$srcdir"/sm.puri.OSK0.desktop \
		"$pkgdir"/usr/share/applications/sm.puri.OSK0.desktop
}

