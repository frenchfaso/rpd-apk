Keep the actual Meson build on the same authenticated lock/vendor graph.
---
--- a/meson.build
+++ b/meson.build
@@ -100,6 +100,12 @@
     configuration: path_data,
 )
 
+configure_file(
+    input: 'Cargo.lock',
+    output: 'Cargo.lock',
+    copy: true,
+)
+
 cargo_build_flags += ['--features', 'zbus_v1_5,clap_v4']
 
 dep_cargo = find_program('cargo')
--- a/cargo.sh
+++ b/cargo.sh
@@ -21,5 +21,5 @@
 # so --manifest-path must not be last
 CMD="$1"
 shift
-cargo "$CMD" --manifest-path "$CARGO_TARGET_DIR"/Cargo.toml "$@"
+cargo "$CMD" --locked --offline --manifest-path "$CARGO_TARGET_DIR"/Cargo.toml "$@"
 
