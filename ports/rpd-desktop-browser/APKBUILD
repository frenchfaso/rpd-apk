pkgname=rpd-desktop-browser
pkgver=0.1.0
pkgrel=53
pkgdesc="Minimal portable Raspberry Pi desktop (rpd-desktop-browser)"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="rpd-desktop-lite chromium rpd-chromium-defaults"
options="!check"

source="rpd-browser rpd-browser-init rpd-browser.desktop mimeapps.list zz-rpd.conf"
package() {
    install -Dm755 "$srcdir/rpd-browser" "$pkgdir/usr/bin/rpd-browser"
    install -Dm755 "$srcdir/rpd-browser-init" "$pkgdir/usr/libexec/rpd-browser-init"
    install -Dm644 "$srcdir/rpd-browser.desktop" "$pkgdir/usr/share/applications/rpd-browser.desktop"
    install -Dm644 "$srcdir/mimeapps.list" "$pkgdir/etc/xdg/rpd/mimeapps.list"
    install -Dm644 "$srcdir/zz-rpd.conf" "$pkgdir/etc/chromium/zz-rpd.conf"
}

