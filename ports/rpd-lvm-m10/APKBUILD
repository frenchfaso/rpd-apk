pkgname=rpd-lvm-m10
pkgver=0.1.0
pkgrel=3
pkgdesc="Opt-in LVM root activation for Lenovo M10 postmarketOS"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="lvm2 losetup"
makedepends="python3"
source="20-rpd-lvm-m10.sh 20-rpd-lvm-m10.files 20-rpd-lvm-m10.modules test-hook.py"
check() {
    sh -n "$srcdir/20-rpd-lvm-m10.sh"
    python3 "$srcdir/test-hook.py"
}
package() {
    install -Dm755 "$srcdir/20-rpd-lvm-m10.sh" "$pkgdir/usr/share/mkinitfs/hooks/20-rpd-lvm-m10.sh"
    install -Dm644 "$srcdir/20-rpd-lvm-m10.files" "$pkgdir/usr/share/mkinitfs/files/20-rpd-lvm-m10.files"
    install -Dm644 "$srcdir/20-rpd-lvm-m10.modules" "$pkgdir/usr/share/mkinitfs/modules/20-rpd-lvm-m10.modules"
    mkdir -p "$pkgdir/usr/share/mkinitfs-triggers"
    touch "$pkgdir/usr/share/mkinitfs-triggers/rpd-lvm-m10"
}

