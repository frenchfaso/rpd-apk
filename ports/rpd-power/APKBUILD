pkgname=rpd-power
pkgver=0.1.0
pkgrel=6
pkgdesc="Explicit battery estimates, local calibration and desktop notifications"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="GPL-2.0-or-later"
depends="python3 libnotify rpd-battery-m10 rpd-battery>=1.11-r25"
makedepends="python3"
install="rpd-power.post-install rpd-power.post-upgrade rpd-power.pre-deinstall"
source="80-rpd-power-monitor.preset power_model.py m10-profiles.json rpd-power-monitor rpd-power-monitor.service rpd-battery-status rpd-power-notify rpd-power-notify.desktop test_power_model.py"
builddir="$srcdir"
check() {
    python3 "$srcdir/test_power_model.py"
}
package() {
    install -Dm644 "$srcdir/80-rpd-power-monitor.preset" "$pkgdir/usr/lib/systemd/system-preset/80-rpd-power-monitor.preset"
    install -Dm644 "$srcdir/power_model.py" "$pkgdir/usr/lib/rpd-power/power_model.py"
    install -Dm644 "$srcdir/m10-profiles.json" "$pkgdir/usr/share/rpd-power/m10-profiles.json"
    install -Dm755 "$srcdir/rpd-power-monitor" "$pkgdir/usr/libexec/rpd-power-monitor"
    install -Dm755 "$srcdir/rpd-power-notify" "$pkgdir/usr/libexec/rpd-power-notify"
    install -Dm755 "$srcdir/rpd-battery-status" "$pkgdir/usr/bin/rpd-battery-status"
    install -Dm644 "$srcdir/rpd-power-monitor.service" "$pkgdir/usr/lib/systemd/system/rpd-power-monitor.service"
    install -Dm644 "$srcdir/rpd-power-notify.desktop" "$pkgdir/etc/xdg/autostart/rpd-power-notify.desktop"
}

