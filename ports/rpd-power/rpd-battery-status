#!/usr/bin/python3
import json,pathlib,time
try:
    data=json.loads(pathlib.Path('/run/rpd-power/status.json').read_text())
    if not -5 <= time.time()-data['timestamp'] <= 90:
        raise ValueError('stale sample')
except (OSError,ValueError,KeyError):
    raise SystemExit('Battery estimate unavailable; check rpd-power-monitor.service')
if data['percentage'] is None:
    print('Estimated charge: unavailable ('+data['estimate_status']+')')
else:
    print(f"Estimated charge: ≈{data['percentage']}% ({data['method']})")
print('Charge integration: '+data.get('integration_source', 'unknown'))
print('Last reference: '+data.get('reference_source', 'unknown'))
print('Capacity learning: '+data.get('learning_status', 'unknown'))
print(f"Battery: {data['voltage_uv']/1e6:.3f} V, {data['current_ua']/1000:+.0f} mA, {data['temp_c']:.1f} °C")
print(f"External power: {'connected' if data['usb_online'] else 'disconnected'}")
print(f"Calibration: {data['full_references']} full-charge references, {data['capacity_updates']} capacity updates")
print('Estimate only. Automatic shutdown based on this percentage is disabled.')

def duration(seconds):
    if seconds is None: return 'unavailable'
    minutes=round(seconds/60)
    return f'{minutes//60} h {minutes%60:02d} min'
print('Estimated runtime: '+duration(data.get('time_to_empty_seconds')))
print('Time to full at current rate: '+duration(data.get('time_to_full_seconds_at_current_rate')))
