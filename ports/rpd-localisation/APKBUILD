}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
    install -Dm755 "$srcdir/rpd-localisation" "$pkgdir/usr/bin/rpd-localisation"
    python3 "$srcdir/generate-data.py" "$pkgdir/usr/share/rpd-localisation"
    install -Dm644 debian/copyright "$pkgdir/usr/share/licenses/$pkgname/copyright"
}

