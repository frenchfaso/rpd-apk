pkgname=rpd-cpu-topology-m10
pkgver=0.1.0
pkgrel=68
pkgdesc="Correct Lenovo M10 SDM429 CPU topology using the current official DTB"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
# boot-deploy/mkinitfs are host integration points supplied by postmarketOS.
# Keep the package installable in the Alpine dependency-test root as well.
depends="python3 py3-libfdt"
makedepends="python3 py3-libfdt"
install="$pkgname.post-deinstall"
source="topology.py test-topology.py commit.py 90-rpd-m10-boot 90-rpd-cpu-topology-m10 deviceinfo"
check() {
    cd "$srcdir"
    python3 test-topology.py
}
package() {
    install -Dm644 "$srcdir/topology.py" "$pkgdir/usr/lib/$pkgname/topology.py"
    install -Dm644 "$srcdir/commit.py" "$pkgdir/usr/lib/$pkgname/commit.py"
    install -Dm755 "$srcdir/90-rpd-m10-boot" "$pkgdir/etc/apk/commit_hooks.d/90-rpd-m10-boot"
    install -Dm755 "$srcdir/90-rpd-cpu-topology-m10" "$pkgdir/usr/share/boot-deploy/hooks/90-rpd-cpu-topology-m10"
    install -Dm644 "$srcdir/deviceinfo" "$pkgdir/etc/deviceinfo"
    mkdir -p "$pkgdir/usr/share/mkinitfs-triggers"
    touch "$pkgdir/usr/share/mkinitfs-triggers/$pkgname"
}

