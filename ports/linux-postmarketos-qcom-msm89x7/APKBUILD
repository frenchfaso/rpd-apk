# Temporary complete-kernel security backport; upstream Linux 7.1 is EOL.
# Based on the reviewed official pmOS 7.1.3-r1 recipe. See security-fixes.json.
maintainer="Barnabas Czeman <barnabas.czeman@postmarketos.org>"
_flavor="postmarketos-qcom-msm89x7"
pkgname=linux-postmarketos-qcom-msm89x7
pkgver=7.1.3
pkgrel=100
pkgdesc="Mainline MSM89x7 kernel with temporary M10 security backports"
arch="aarch64"
_carch="arm64"
url="https://github.com/msm89x7-mainline/linux"
license="GPL-2.0-only"
options="!strip !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	pmb:kconfigcheck-uefi
"
makedepends="
	bison
	clang23
	elfutils-dev
	findutils
	flex
	linux-headers
	lld23
	llvm23
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"
_tag="$pkgver-r1"
_config="config-$_flavor.$arch"
source="
	$pkgname-v$_tag.tar.gz::$url/archive/v$_tag.tar.gz
	$_config
	check-kernel-config.py
	security-fixes.json
	0001-CVE-2026-98858.patch
	0002-CVE-2026-98823.patch
	0003-CVE-2026-72112.patch
	0004-CVE-2026-98850.patch
	0005-CVE-2026-100077.patch
	0006-CVE-2026-93059.patch
	0007-CVE-2026-81000.patch
	0008-CVE-2026-98829.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	export PATH=/usr/lib/llvm23/bin:$PATH
	make ARCH="$_carch" LLVM=1 olddefconfig
	python3 "$srcdir/check-kernel-config.py" "$srcdir/$_config" .config "$PWD"
	# The explicit target writes real built-in exports to vmlinux.symvers.
	# A full build writes Module.symvers instead and preserves that first table.
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" vmlinux
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

check() {
	export PATH=/usr/lib/llvm23/bin:$PATH
	python3 "$srcdir/check-kernel-config.py" "$srcdir/$_config" .config "$PWD"
	test "$(make -s ARCH="$_carch" LLVM=1 kernelrelease)" = 7.1.3-msm89x7
	test -s vmlinux.symvers
	test -s Module.symvers
	# Check every complete fix, without fuzzy matching or partial application.
	for fix in 0001-CVE-2026-98858.patch 0002-CVE-2026-98823.patch \
		0003-CVE-2026-72112.patch 0004-CVE-2026-98850.patch \
		0005-CVE-2026-100077.patch 0006-CVE-2026-93059.patch \
		0007-CVE-2026-81000.patch 0008-CVE-2026-98829.patch; do
		patch --batch --reverse --fuzz=0 --dry-run -p1 < "$srcdir/$fix"
	done
}

package() {
	export PATH=/usr/lib/llvm23/bin:$PATH
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
		"$pkgdir/boot/vmlinuz"
	# Record the real generated config, including equivalent tool metadata.
	install -Dm644 .config "$pkgdir/boot/config"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
	install -Dm644 include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	install -Dm644 "$srcdir/security-fixes.json" \
		"$pkgdir/usr/share/kernel/$_flavor/rpd-security-fixes.json"
}

