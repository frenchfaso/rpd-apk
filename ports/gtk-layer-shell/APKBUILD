# Alpine compatibility build: GTK 3.24.52 carries GNOME MR 5628.
pkgname=gtk-layer-shell
pkgver=0.10.1
pkgrel=133
pkgdesc="GTK Layer Shell with Alpine GTK touch-seat ABI compatibility"
url="https://github.com/wmww/gtk-layer-shell"
arch="aarch64"
license="LGPL-3.0-or-later AND MIT"
makedepends="gobject-introspection-dev gtk+3.0-dev meson samurai vala wayland-dev wayland-protocols"
subpackages="$pkgname-dev $pkgname-rpd-test:rpd_test"
options="!check" # Runtime seat ABI regression runs under labwc in repository smoke.
source="$pkgname-$pkgver.tar.gz::https://codeload.github.com/wmww/gtk-layer-shell/tar.gz/refs/tags/v$pkgver
    alpine-touch-seat.patch seat-abi-probe.c"
build() {
    # Private ABI adaptation is reviewed against this GTK release, not guessed.
    test "$(pkg-config --modversion gtk+-3.0)" = 3.24.52
    abuild-meson -Db_lto=false -Dexamples=false -Ddocs=false -Dtests=false . output
    meson compile -C output
    cc -fvisibility=hidden -DGTK_LAYER_SHELL_MAJOR=0 -DGTK_LAYER_SHELL_MINOR=10 -DGTK_LAYER_SHELL_MICRO=1 "$srcdir/seat-abi-probe.c" -I src -I gtk-priv/h $(pkg-config --cflags --libs gtk+-3.0 wayland-client) -Loutput/src -lgtk-layer-shell -o output/seat-abi-probe
}
package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
    install -Dm755 output/seat-abi-probe "$pkgdir/usr/libexec/rpd-gtk-seat-probe"
}
rpd_test() {
    pkgdesc="Regression probe for Alpine GTK touch-seat ABI"
    amove usr/libexec/rpd-gtk-seat-probe
}
sha512sums="
