337fd99609b0aaa58d7c6d48ea4c911fbc46730e04393d670c135186959feddb85bb964a304006e5201ef0c9874a285519ceaf874cb8d611fb7070e0a80b5d0a  alpine-touch-seat.patch
0cf2f83297d90ac94d73c3eda480720046100296d3ce7fd58fff468dc73b72f87b1f96c7c5d4239d1afbdd9b3621c6d8cba4a2e5aa58953fcce5929161e7091c  seat-abi-probe.c
"
