pkgname=rpd-login
pkgver=0.1.0
pkgrel=14
pkgdesc="LightDM with the Raspberry Pi Wayland greeter and on-screen keyboard"
url="https://github.com/frenchfaso/rpd-apk"
arch="noarch"
license="MIT"
depends="lightdm rpd-greeter labwc dbus squeekboard rpd-session"
options="!check"
source="rpd-greeter-session greeter-autostart greeter-rc.xml rpd-greeter-labwc.desktop 60-rpd.conf"
package() {
    install -Dm755 "$srcdir/rpd-greeter-session" "$pkgdir/usr/bin/rpd-greeter-session"
    install -Dm755 "$srcdir/greeter-autostart" "$pkgdir/etc/xdg/rpd/greeter/autostart"
    install -Dm644 "$srcdir/greeter-rc.xml" "$pkgdir/etc/xdg/rpd/greeter/rc.xml"
    install -Dm644 "$srcdir/rpd-greeter-labwc.desktop" "$pkgdir/usr/share/xgreeters/rpd-greeter-labwc.desktop"
    install -Dm644 "$srcdir/60-rpd.conf" "$pkgdir/etc/lightdm/lightdm.conf.d/60-rpd.conf"
}
