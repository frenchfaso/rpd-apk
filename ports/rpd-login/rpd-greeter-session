#!/bin/sh
set -eu
export XDG_CURRENT_DESKTOP=labwc
export XDG_SESSION_TYPE=wayland
export XCURSOR_THEME=PiXtrix
export XCURSOR_SIZE=24
[ ! -f /etc/xdg/rpd/greeter-renderer.conf ] || . /etc/xdg/rpd/greeter-renderer.conf
if [ "${RPD_SOFTWARE_RENDERING:-0}" = 1 ]; then
    export WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1
fi
# LightDM stops this launcher at login. Terminate its entire private process
# group so no greeter compositor, keyboard or session bus survives that handoff.
# Rotation writes touchscreen mappings; never grant LightDM write access to /etc.
runtime_config=$(mktemp -d "${XDG_RUNTIME_DIR:?}/rpd-greeter.XXXXXX")
cp -R /etc/xdg/rpd/greeter/. "$runtime_config/"
rpd-screen-power configure "$runtime_config/rc.xml" || :
rpd-screen-power restore || :
export RPD_CONFIG_DIR="$runtime_config"
setsid dbus-run-session -- labwc --config-dir "$runtime_config" &
session=$!
cleanup() {
    trap - EXIT HUP INT TERM
    rpd-screen-power restore || :
    kill -TERM -- "-$session" 2>/dev/null || :
    rm -rf -- "$runtime_config"
}
trap cleanup EXIT HUP INT TERM
wait "$session"
